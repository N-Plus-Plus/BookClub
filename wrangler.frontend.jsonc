{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bookclub-frontend",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [{ "pattern": "bookclub.nissen.nexus", "custom_domain": true }]
}
