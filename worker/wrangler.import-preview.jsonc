{
  "dev": { "ip": "127.0.0.1", "port": 10263, "inspector_port": 10265 },
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "bookclub-import-preview",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "env": {
    "import_preview": {
      "name": "bookclub-import-preview-local",
      "vars": { "APP_ENV": "local", "LOCAL_WRITE_BYPASS": "true", "ALLOWED_ORIGINS": "http://localhost:10260,http://127.0.0.1:10260" },
      "d1_databases": [{ "binding": "DB", "database_name": "bookclub-import-preview", "database_id": "00000000-0000-0000-0000-000000000002", "migrations_dir": "migrations" }]
    }
  }
}
